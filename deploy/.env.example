ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_HTTP_PORTS=8080

AllowedHosts=app.example.com
Cors__AllowedOrigins__0=https://app.example.com

TwitchAuth__ClientId=replace_me
TwitchAuth__ClientSecret=replace_me
TwitchAuth__RedirectUri=https://app.example.com/auth/twitch/callback
TwitchAuth__FrontendRedirectUri=https://app.example.com/auth/callback
TwitchAuth__Scopes__0=openid

ConnectionStrings__DefaultConnection=Host=postgres.internal;Port=5432;Database=deadmans;Username=deadmans;Password=replace_me;SSL Mode=VerifyFull;Root Certificate=/run/secrets/postgres-ca.crt
Database__ApplyMigrationsOnStartup=true

Storage__PublicBaseUrl=https://s3.example.com
Storage__ServiceUrl=https://s3.example.com
Storage__BucketName=deadmans-media
Storage__AccessKey=replace_me
Storage__SecretKey=replace_me
Storage__GamesPrefix=games
Storage__CardsGroup=cards

DataProtection__KeysDirectory=/var/lib/deadmans/keys

ForwardedHeaders__Enabled=true
ForwardedHeaders__TrustedNetworks__0=replace_with_coolify_network_cidr
ForwardedHeaders__TrustAllProxiesInDevelopment=false
